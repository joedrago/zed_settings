{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "FireCode",
  "author": "Ported from gerane.theme-firecode (TextMate origin)",
  "themes": [
    {
      "name": "FireCode",
      "appearance": "dark",
      "style": {
        "background": "#191919",
        "border": "#2a2a2a",
        "border.variant": "#262626",
        "border.focused": "#2e98e2",
        "border.selected": "#515151",
        "border.transparent": "#00000000",
        "border.disabled": "#2a2a2a",
        "elevated_surface.background": "#1f1f1f",
        "surface.background": "#1c1c1c",
        "panel.background": "#1c1c1c",
        "panel.focused_border": "#515151",
        "pane.focused_border": "#515151",
        "scrollbar.thumb.background": "#3d3d3d80",
        "scrollbar.thumb.hover_background": "#515151aa",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#19191900",
        "scrollbar.track.border": "#00000000",
        "text": "#f8f8f2",
        "text.muted": "#a0a0a0",
        "text.placeholder": "#6d6d6d",
        "text.disabled": "#5a5a5a",
        "text.accent": "#2e98e2",
        "icon": "#f8f8f2",
        "icon.muted": "#a0a0a0",
        "icon.disabled": "#5a5a5a",
        "icon.accent": "#2e98e2",
        "status_bar.background": "#5a5a5a",
        "title_bar.background": "#1c1c1c",
        "title_bar.inactive_background": "#191919",
        "toolbar.background": "#191919",
        "tab_bar.background": "#1c1c1c",
        "tab.active_background": "#191919",
        "tab.inactive_background": "#1c1c1c",
        "search.match_background": "#fc935455",
        "editor.background": "#191919",
        "editor.foreground": "#f8f8f2",
        "editor.gutter.background": "#191919",
        "editor.line_number": "#5a5a5a",
        "editor.active_line_number": "#f8f8f2",
        "editor.active_line.background": "#3d3d3d55",
        "editor.highlighted_line.background": "#3d3d3d55",
        "editor.invisible": "#3b3a32",
        "editor.wrap_guide": "#2a2a2a",
        "editor.active_wrap_guide": "#3d3d3d",
        "editor.document_highlight.read_background": "#51515166",
        "editor.document_highlight.write_background": "#51515166",
        "editor.hint": "#aaffaa",
        "editor.subheader.background": "#1c1c1c",
        "terminal.background": "#191919",
        "terminal.foreground": "#f8f8f2",
        "terminal.bright_foreground": "#ffffff",
        "terminal.dim_foreground": "#6d6d6d",
        "terminal.ansi.black": "#191919",
        "terminal.ansi.red": "#f63249",
        "terminal.ansi.green": "#97d8ea",
        "terminal.ansi.yellow": "#fc9354",
        "terminal.ansi.blue": "#2e98e2",
        "terminal.ansi.magenta": "#ffb2f9",
        "terminal.ansi.cyan": "#73c3d2",
        "terminal.ansi.white": "#f8f8f2",
        "terminal.ansi.bright_black": "#5a5a5a",
        "terminal.ansi.bright_red": "#f92649",
        "terminal.ansi.bright_green": "#aaffaa",
        "terminal.ansi.bright_yellow": "#ffd2a6",
        "terminal.ansi.bright_blue": "#8ecfdb",
        "terminal.ansi.bright_magenta": "#ffe1fc",
        "terminal.ansi.bright_cyan": "#90e7f7",
        "terminal.ansi.bright_white": "#ffffff",
        "error": "#f63249",
        "error.background": "#f6324933",
        "error.border": "#f63249",
        "warning": "#fc9354",
        "warning.background": "#fc935433",
        "warning.border": "#fc9354",
        "info": "#2e98e2",
        "info.background": "#2e98e233",
        "info.border": "#2e98e2",
        "success": "#97d8ea",
        "success.background": "#97d8ea33",
        "success.border": "#97d8ea",
        "hint": "#aaffaa",
        "hint.background": "#aaffaa22",
        "hint.border": "#aaffaa",
        "predictive": "#6d6d6d",
        "players": [
          {
            "cursor": "#f8f8f0",
            "selection": "#515151",
            "background": "#2e98e2"
          }
        ],
        "syntax": {
          "comment":             { "color": "#6d6d6d" },
          "comment.doc":         { "color": "#6d6d6d" },
          "string":              { "color": "#97d8ea" },
          "string.escape":       { "color": "#fc9354" },
          "string.regex":        { "color": "#97d8ea" },
          "string.special":      { "color": "#97d8ea" },
          "number":              { "color": "#fc9354" },
          "boolean":             { "color": "#fc9354" },
          "constant":            { "color": "#fc9354" },
          "keyword":             { "color": "#f63249" },
          "operator":            { "color": "#f63249" },
          "type":                { "color": "#73c3d2", "font_style": "italic" },
          "type.builtin":        { "color": "#8ecfdb", "font_style": "italic" },
          "function":            { "color": "#2e98e2" },
          "function.method":     { "color": "#2e98e2" },
          "function.builtin":    { "color": "#8ecfdb" },
          "function.special":    { "color": "#8ecfdb" },
          "constructor":         { "color": "#2e98e2" },
          "variable":            { "color": "#f8f8f2" },
          "variable.parameter":  { "color": "#fc9354", "font_style": "italic" },
          "variable.special":    { "color": "#ffb2f9" },
          "property":            { "color": "#f8f8f2" },
          "tag":                 { "color": "#f63249" },
          "attribute":           { "color": "#2e98e2" },
          "label":               { "color": "#2e98e2" },
          "preproc":             { "color": "#f63249" },
          "punctuation":         { "color": "#f8f8f2" },
          "punctuation.bracket": { "color": "#f8f8f2" },
          "punctuation.delimiter": { "color": "#f8f8f2" },
          "punctuation.special": { "color": "#f63249" },
          "punctuation.list_marker": { "color": "#fc9354" },
          "embedded":            { "color": "#f8f8f2" },
          "emphasis":            { "color": "#fc9354", "font_style": "italic" },
          "emphasis.strong":     { "color": "#fc9354", "font_weight": 700 },
          "title":               { "color": "#2e98e2", "font_weight": 700 },
          "link_text":           { "color": "#97d8ea", "font_style": "italic" },
          "link_uri":            { "color": "#8ecfdb" },
          "text.literal":        { "color": "#97d8ea" },
          "primary":             { "color": "#f8f8f2" },
          "predictive":          { "color": "#6d6d6d", "font_style": "italic" },
          "hint":                { "color": "#aaffaa" },
          "enum":                { "color": "#73c3d2" },
          "variant":             { "color": "#73c3d2" }
        }
      }
    }
  ]
}
